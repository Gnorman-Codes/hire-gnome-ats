{
  "info": {
    "name": "Hire Gnome Phase 1 API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Set baseUrl and apiKey in your active Postman environment. Create a Read and Write key for the full workflow. List Records also works with a Read Only key. Each full run writes fictional sample records."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{apiKey}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:43177/api/v1"
    },
    {
      "key": "apiKey",
      "value": ""
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "clientId",
      "value": ""
    },
    {
      "key": "contactId",
      "value": ""
    },
    {
      "key": "jobId",
      "value": ""
    },
    {
      "key": "candidateId",
      "value": ""
    },
    {
      "key": "submissionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 · List Assignable Owners",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/owners?limit=10",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns HTTP 200', () => pm.response.to.have.status(200));",
              "const payload = pm.response.json();",
              "pm.test('Returns an owner list', () => pm.expect(payload.data).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 · Create Client",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/clients",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Copperline Postman {{runId}}\",\n  \"zipCode\": \"10001\",\n  \"industry\": \"Technology\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('runId', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns HTTP 201', () => pm.response.to.have.status(201));",
              "const payload = pm.response.json();",
              "pm.test('Returns a record ID', () => pm.expect(payload.data.recordId).to.be.a('string').and.not.empty);",
              "if (pm.response.code === 201 && payload.data?.recordId) pm.collectionVariables.set('clientId', payload.data.recordId);"
            ]
          }
        }
      ]
    },
