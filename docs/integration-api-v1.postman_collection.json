    },
    {
      "name": "08 · Update Submission Status and Notes",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/submissions/{{submissionId}}",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"under_review\",\n  \"notes\": \"Hiring manager is reviewing.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns HTTP 200', () => pm.response.to.have.status(200));",
              "const payload = pm.response.json();",
              "pm.test('Returns saved status and notes', () => { pm.expect(payload.data.status).to.equal('under_review'); pm.expect(payload.data.notes).to.equal('Hiring manager is reviewing.'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "09 · Retry Original Submission",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/submissions",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"candidateRecordId\": \"{{candidateId}}\",\n  \"jobOrderRecordId\": \"{{jobId}}\",\n  \"status\": \"submitted\",\n  \"notes\": \"Candidate is interested in the role.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
