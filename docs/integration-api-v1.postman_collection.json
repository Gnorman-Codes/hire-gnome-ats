      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns HTTP 200', () => pm.response.to.have.status(200));",
              "const payload = pm.response.json();",
              "pm.test('Returns the expected record ID', () => pm.expect(payload.data.recordId).to.equal(pm.collectionVariables.get('submissionId')));",
              "pm.test('Returns saved status and notes', () => { pm.expect(payload.data.status).to.equal('under_review'); pm.expect(payload.data.notes).to.equal('Hiring manager is reviewing.'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "10 · Reopen Submission",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/submissions/{{submissionId}}",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns HTTP 200', () => pm.response.to.have.status(200));",
              "const payload = pm.response.json();",
              "pm.test('Returns the saved relationships', () => { pm.expect(payload.data.candidateRecordId).to.equal(pm.collectionVariables.get('candidateId')); pm.expect(payload.data.jobOrderRecordId).to.equal(pm.collectionVariables.get('jobId')); });",
              "pm.test('Returns saved status and notes', () => { pm.expect(payload.data.status).to.equal('under_review'); pm.expect(payload.data.notes).to.equal('Hiring manager is reviewing.'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "List Records",
      "description": "Use a cursor from page.nextCursor with the same filters to request the next page.",
      "item": [
        {
          "name": "List Clients",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/clients?limit=10",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns HTTP 200', () => pm.response.to.have.status(200));",
                  "const payload = pm.response.json();",
                  "pm.test('Returns up to 10 records', () => { pm.expect(payload.data).to.be.an('array'); pm.expect(payload.data.length).to.be.at.most(10); });",
                  "pm.test('Returns a cursor or null', () => pm.expect(payload.page.nextCursor === null || typeof payload.page.nextCursor === 'string').to.be.true);"
                ]
              }
            }
          ]
        },
