            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"candidateRecordId\": \"{{candidateId}}\",\n  \"jobOrderRecordId\": \"{{jobId}}\",\n  \"status\": \"submitted\",\n  \"notes\": \"Candidate is interested in the role.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
